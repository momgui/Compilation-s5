type token =
    VAR
  | TYPE
  | TRUE
  | STRUCT
  | STRING of string
  | STAR
  | SEMI
  | RPAR
  | RETURN
  | PLUS
  | PERCENT
  | PACKAGE
  | OR
  | NOT
  | NIL
  | NEQ
  | MINUS
  | LT
  | LPAR
  | LE
  | INT of int64
  | INCR
  | IMPORT
  | IF
  | IDENT of string
  | GT
  | GE
  | FUNC
  | FOR
  | FALSE
  | EQ
  | EOF
  | END
  | ELSE
  | DOT
  | DIV
  | DECR
  | COMMA
  | COLONASSIGN
  | BEGIN
  | ASSIGN
  | AND
exception Error
